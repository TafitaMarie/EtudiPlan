// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tache {
  id        Int      @id @default(autoincrement())
  titre     String
  faite     Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Cours {
  id          Int    @id @default(autoincrement())
  matiere     String
  jour        String
  heureDebut  String
  heureFin    String
  salle       String
  couleur     String @default("blue")
}

model Transaction {
  id        Int      @id @default(autoincrement())
  libelle   String
  categorie String
  montant   Float
  type      String
  date      DateTime @default(now())
}
